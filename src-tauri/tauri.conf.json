{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Console Mode",
  "version": "0.4.4",
  "identifier": "com.akkaaassh.consolemode",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Console Mode",
        "width": 1280,
        "height": 720,
        "fullscreen": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#05070d",
        "theme": "Dark",
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
